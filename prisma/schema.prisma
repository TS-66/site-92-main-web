generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Credential {
  id            String   @id @default(cuid()) @map("_id")
  username      String   @unique
  password      String
  discordUserId String?  @unique
  createdAt     DateTime @default(now())
}

model Ticket {
  id        String          @id @default(cuid()) @map("_id")
  ticketId  String          @unique
  username  String
  status    String          @default("OPEN")
  subject   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid()) @map("_id")
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [ticketId])
  sender    String
  text      String
  createdAt DateTime @default(now())
}

model VerificationCode {
  id        String   @id @default(cuid()) @map("_id")
  username  String   @unique
  code      String
  createdAt DateTime @default(now())
}

// ---- ADMIN PANEL MODELS ----

model AdminAccount {
  id            String   @id @default(cuid()) @map("_id")
  username      String   @unique
  password      String
  discordUserId String?  @unique
  createdAt     DateTime @default(now())
}

model SiteScp {
  id          String   @id @default(cuid()) @map("_id")
  scpId       String
  name        String
  objectClass String
  threat      String
  zone        String   @default("STANDARD")
  description String
  addedBy     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TestLog {
  id          String   @id @default(cuid()) @map("_id")
  scpRef      String
  title       String
  researchers String
  result      String
  severity    String   @default("MINOR")
  addedBy     String
  createdAt   DateTime @default(now())
}

model SiteProtocol {
  id          String   @id @default(cuid()) @map("_id")
  code        String   @unique
  name        String
  target      String   @default("SITE-WIDE")
  status      String   @default("STANDBY")
  assignedTo  String   @default("N/A")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteStatus {
  id    String @id @default(cuid()) @map("_id")
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}

model Incident {
  id          String   @id @default(cuid()) @map("_id")
  code        String   @unique
  title       String
  severity    String   @default("MODERATE")
  sector      String   @default("UNKNOWN")
  description String
  status      String   @default("ACTIVE")
  reportedBy  String   @default("SYSTEM")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnomalyReport {
  id          String   @id @default(cuid()) @map("_id")
  reporterName String
  scpRef      String
  location    String
  description String
  contact     String   @default("")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsItem {
  id          String   @id @default(cuid()) @map("_id")
  tag         String   @default("info")
  title       String
  body        String
  author      String   @default("SYSTEM")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
